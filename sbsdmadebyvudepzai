-- Hàm quét 3-4 mục tiêu gần nhất
local function getMultipleTargets()
    local targets = {}
    local character = LocalPlayer.Character
    if not character or not character:FindFirstChild("HumanoidRootPart") then return targets end
    local myPos = character.HumanoidRootPart.Position

    for _, obj in pairs(Workspace:GetDescendants()) do
        if obj:IsA("Model") and obj:FindFirstChild("Humanoid") and obj:FindFirstChild("HumanoidRootPart") then
            local isPlayer = Players:GetPlayerFromCharacter(obj) ~= nil
            local isAlly = obj:FindFirstChild("Ally") or obj:FindFirstChild("TeamTag")
            
            if not isPlayer and not isAlly and obj.Humanoid.Health > 0 then
                if string.find(string.lower(obj.Name), "toilet") or obj.Parent.Name == "Enemies" or obj.Parent.Name == "Mobs" then
                    local dist = (obj.HumanoidRootPart.Position - myPos).Magnitude
                    table.insert(targets, {model = obj, distance = dist})
                end
            end
        end
    end

    table.sort(targets, function(a, b) return a.distance < b.distance end)

    local topTargets = {}
    for i = 1, math.min(4, #targets) do
        table.insert(topTargets, targets[i].model)
    end
    return topTargets
end

-- Hàm phát hiện đạn / vật thể sát thương bay tới
local function checkIncomingDanger()
    local character = LocalPlayer.Character
    if not character or not character:FindFirstChild("HumanoidRootPart") then return false end
    local myPos = character.HumanoidRootPart.Position
    
    for _, obj in pairs(Workspace:GetDescendants()) do
        if obj:IsA("BasePart") and not obj:IsDescendantOf(character) then
            local name = string.lower(obj.Name)
            if string.find(name, "bullet") or string.find(name, "projectile") or string.find(name, "bomb") or 
               string.find(name, "laser") or string.find(name, "hazard") or string.find(name, "trap") or 
               string.find(name, "fire") or string.find(name, "slash") or string.find(name, "missile") then
                local dist = (obj.Position - myPos).Magnitude
                if dist < 22 then return true end
            end
        end
    end
    return false
end

