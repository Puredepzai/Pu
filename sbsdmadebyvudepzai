                                local randomOffsetZ = math.random(-25, 25)
                                hrp.CFrame = CFrame.new(hrp.Position + Vector3.new(randomOffsetX, 5, randomOffsetZ))
                                hrp.AssemblyLinearVelocity = Vector3.new(0, 0, 0)
                            else
                                -- 2. MULTI-TARGET BLITZ: Dịch chuyển càn quét 3-4 quái cùng lúc
                                local targets = getMultipleTargets()
                                if #targets > 0 then
                                    Camera.CameraType = Enum.CameraType.Custom
                                    
                                    for _, target in ipairs(targets) do
                                        if not autoRunning then break end
                                        if target and target:FindFirstChild("HumanoidRootPart") then
                                            local targetHRP = target.HumanoidRootPart
                                            
                                            hrp.CFrame = targetHRP.CFrame + Vector3.new(math.random(-3, 3), 2, math.random(-3, 3))
                                            hrp.AssemblyLinearVelocity = Vector3.new(0, 0, 0)
                                            
                                            if target:FindFirstChild("Head") then
                                                target.Head.Size = Vector3.new(22, 22, 22)
                                                target.Head.Transparency = 0.7
                                                target.Head.CanCollide = false
                                            end
                                            targetHRP.Size = Vector3.new(28, 28, 28)
                                            targetHRP.Transparency = 0.9
                                            
                                            for _, desc in pairs(target:GetDescendants()) do
                                                if desc:IsA("ProximityPrompt") then
                                                    desc.HoldDuration = 0
                                                    fireproximityprompt(desc)
                                                end
                                            end
                                            
                                            local sawSlash = character:FindFirstChild("sawSlash")
                                            if sawSlash then
                                                local remote = sawSlash:FindFirstChild("Remote")
                                                if remote and remote:IsA("RemoteEvent") then
                                                    remote:FireServer("LeftDown")
                                                end
                                            end
                                            
                                            -- Giả lập chạm màn hình chuẩn Mobile (Không làm mất nút skill game)
                                            pcall(function()
                                                VirtualUser:Button1Down(Vector2.new(0,0))
